# Copy this file to .env and change the values. .env is git-ignored; this example file is not.
# These are local development values only, never real secrets.

POSTGRES_DB=hindsight
POSTGRES_USER=hindsight
POSTGRES_PASSWORD=change-me-local-only

HINDSIGHT_LOG_LEVEL=INFO

# Used when you run the API or Alembic on your machine (outside Docker). Same user/password as above.
# Inside Docker Compose this is overridden to point at the "db" container instead of localhost.
HINDSIGHT_DATABASE_URL=postgresql+psycopg://hindsight:change-me-local-only@127.0.0.1:5432/hindsight

# Password given to the demo users (alice/bob/carol@example.com) by the seed script. Local/demo only.
HINDSIGHT_SEED_PASSWORD=demo-password-local-only

# Signs the access tokens (JWT). Any random string of 32+ characters; make your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HINDSIGHT_JWT_SECRET=change-me-local-only-change-me-local-only

# Optional: real market data from https://www.tiingo.com (free account). Leave empty to use
# demo prices, which are generated and clearly labelled "demo" in the app.
HINDSIGHT_TIINGO_API_KEY=
