# Copy this file to .env and change the values. .env is git-ignored; this example file is not.
# These are local development values only, never real secrets.

POSTGRES_DB=hindsight
POSTGRES_USER=hindsight
POSTGRES_PASSWORD=change-me-local-only

HINDSIGHT_LOG_LEVEL=INFO

# Used when you run the API or Alembic on your machine (outside Docker). Same user/password as above.
# Inside Docker Compose this is overridden to point at the "db" container instead of localhost.
HINDSIGHT_DATABASE_URL=postgresql+psycopg://hindsight:change-me-local-only@127.0.0.1:5432/hindsight
